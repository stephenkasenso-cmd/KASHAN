datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Person {
  person_id             Int           @id @default(autoincrement())
  first_name            String
  last_name             String
  fullName              String?
  maiden_name           String?
  gender                String        // Enforced values: 'Male', 'Female', 'Other', 'Unknown'
  photoUrl              String?
  birth_date            DateTime?
  birth_place           String?
  death_date            DateTime?
  death_place           String?
  burialPlace           String?
  is_living             Boolean       @default(true)
  bio                   String?
  ghana_card            String?
  gps_address           String?
  phone                 String?
  email                 String?
  currentAddress        String?
  hometown              String?
  profession            String?
  employer              String?
  church                String?
  baptismDetails        String?
  bloodGroup            String?       // "A+", "O+", "A-", etc.
  genotype              String?       // "AA", "AS", "SS", "AC"
  educationJson         String?       // JSON string
  documentsJson         String?       // JSON string
  biographyJson         String?       // JSON string
  clan_id               Int?
  paramountcy_id        Int?
  sub_stool_id          Int?
  enstoolment_date      DateTime?

  // Direct Parent References
  fatherId              Int?
  motherId              Int?
  father                Person?       @relation("FatherToChildren", fields: [fatherId], references: [person_id])
  mother                Person?       @relation("MotherToChildren", fields: [motherId], references: [person_id])
  fatherChildren        Person[]      @relation("FatherToChildren")
  motherChildren        Person[]      @relation("MotherToChildren")

  // Marital Relations
  marriagesAsSpouse1    Marriage[]    @relation("Spouse1")
  marriagesAsSpouse2    Marriage[]    @relation("Spouse2")

  // Relations
  relationships1        Relationship[] @relation("Person1")
  relationships2        Relationship[] @relation("Person2")
  sources               Source[]
  clan                  Clan?          @relation(fields: [clan_id], references: [id])
  paramountcy           Paramountcy?   @relation(fields: [paramountcy_id], references: [id])
  sub_stool             SubStool?      @relation(fields: [sub_stool_id], references: [id])

  // Asantehene Dynastic & Succession Fields
  dynasticOrder         Int?          @unique  // legacy – kept for compat
  dynasticNumber        Int?          @unique  // canonical field for horizontal peer chain
  reignStartYear        Int?
  reignEndYear          Int?
  predecessorId         Int?          @unique
  successorId           Int?          @unique
  // KingSuccession – horizontal peer chain (NOT biological parent-child)
  predecessor           Person?       @relation("KingSuccession", fields: [predecessorId], references: [person_id])
  successor             Person?       @relation("KingSuccession")
}

model Marriage {
  id                    Int           @id @default(autoincrement())
  spouse1Id             Int
  spouse2Id             Int
  marriageDate          DateTime?
  marriagePlace         String?

  spouse1               Person        @relation("Spouse1", fields: [spouse1Id], references: [person_id], onDelete: Cascade)
  spouse2               Person        @relation("Spouse2", fields: [spouse2Id], references: [person_id], onDelete: Cascade)

  createdAt             DateTime      @default(now())
}

model Clan {
  id          Int       @id @default(autoincrement())
  name        String    @unique // e.g., Bretuo
  totem       String?   // e.g., The Leopard
  description String?
  persons     Person[]
}

model Region {
  id             Int             @id @default(autoincrement())
  name           String          @unique // e.g., Ashanti Region
  paramountcies  Paramountcy[]
}

model Paramountcy {
  id          Int        @id @default(autoincrement())
  name        String     // e.g., Kumasi Traditional Council
  region_id   Int
  region      Region     @relation(fields: [region_id], references: [id])
  sub_stools  SubStool[]
  persons     Person[]
}

model SubStool {
  id             Int         @id @default(autoincrement())
  name           String
  paramountcy_id Int
  paramountcy    Paramountcy @relation(fields: [paramountcy_id], references: [id])
  persons        Person[]
}

model Relationship {
  relationship_id   Int       @id @default(autoincrement())
  person_id_1       Int
  person_id_2       Int
  relationship_type String    // Enforced values: 'Parent-Child', 'Spouse', 'Partner', etc.
  subtype           String    // Enforced values: 'Biological', 'Adoptive', 'Step', 'Foster', 'None', etc.
  category          String    @default("PARENT_CHILD") // Enforced values: 'PARENT_CHILD', 'SIBLING', 'SPOUSE', 'DYNASTIC_SUCCESSOR', 'QUEEN_MOTHER_STOOL_PAIR', 'FEKUO_SUB_STOOL'
  traditionalRole  String?   // e.g., "Krontihene", "16th Asantehene", "Asantehemaa"
  status            String?   // Enforced values: 'Married', 'Divorced', 'Widowed', 'Separated', 'Active'
  start_date        DateTime?
  end_date          DateTime?
  notes             String?

  // Relations mapping
  person_1          Person    @relation("Person1", fields: [person_id_1], references: [person_id], onDelete: Cascade)
  person_2          Person    @relation("Person2", fields: [person_id_2], references: [person_id], onDelete: Cascade)

  // Constraints and Indexes
  @@unique([person_id_1, person_id_2, category], name: "person_pair_category_unique")
  @@index([person_id_1])
  @@index([person_id_2])
}

model Source {
  source_id        Int       @id @default(autoincrement())
  person_id        Int
  title            String
  document_type    String?
  url              String?
  publication_date DateTime?

  // Relations mapping
  person           Person    @relation(fields: [person_id], references: [person_id], onDelete: Cascade)
}

model User {
  user_id       Int      @id @default(autoincrement())
  username      String   @unique
  email         String?  @unique
  password_hash String?
  salt          String?
  role          String   @default("Staff")
  google_id     String?  @unique
  avatar_url    String?
  created_at    DateTime @default(now())
}

model TraditionalStool {
  id                  Int                 @id @default(autoincrement())
  stoolName           String              // e.g., "Amaniampong Silver Stool", "Yiadom & Hwedie Stool"
  title               String              // e.g., "Mamponhene", "Mamponhemaa", "Dwabenhene"
  town                String              // e.g., "Mampong", "Juaben", "Koforidua", "Ho"
  region              String              // e.g., "Ashanti", "Eastern", "Volta", "Bono"
  category            String              @default("REGIONAL_PARAMOUNT") // "AMANTOO_FOUNDING", "KUMASI_DIVISIONAL", "REGIONAL_PARAMOUNT", "DIVISIONAL_SUB", "GENERAL_GHANA_TRADITIONAL"
  rank                String              // "KING", "QUEEN_MOTHER_SUPREME", "AMANHENE", "AMANHEMAA", "DIVISIONAL_CHIEF", "DIVISIONAL_QUEEN_MOTHER", "SUB_CHIEF", "SUB_QUEEN_MOTHER"
  
  // Current Occupant & Lineage
  currentOccupant     String?
  clan                String?             // e.g., "Bretuo", "Oyoko", "Aduana"
  palaceName          String?             // e.g., "Amaniampong Palace"
  seatLocation        String?
  enstoolmentDate     DateTime?
  imageUrl            String?

  // Wing / Military / Palace Division (Fekuo)
  militaryWing        String?             // e.g., "Kronti", "Nifa", "Benkum", "Adonten", "Gyaase", "Ankobea"
  notes               String?

  // Parent Stool Relational Link (Supports Hierarchical Councils & Sub-Queen Mothers)
  parentStoolId       Int?
  parentStool         TraditionalStool?   @relation("StoolHierarchy", fields: [parentStoolId], references: [id])
  subStools           TraditionalStool[]  @relation("StoolHierarchy")

  // Link to Queen Mother counterpart (Direct male-female stool pairing)
  queenMotherStoolId  Int?                @unique
  queenMotherStool    TraditionalStool?   @relation("ChiefQueenPair", fields: [queenMotherStoolId], references: [id])
  chiefStool          TraditionalStool?   @relation("ChiefQueenPair")

  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
}
